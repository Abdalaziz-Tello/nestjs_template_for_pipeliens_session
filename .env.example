# Copy this file to `.env` for local development:   cp .env.example .env
# On Render, add the same keys under: Service -> Environment -> Environment Variables.
# NEVER commit `.env` (it is in .gitignore). Only this example file goes to git.

# Render sets PORT automatically. Locally the app uses 3000 if this is empty.
PORT=3000

APP_NAME="NestJS Template"
APP_ENV=development
APP_VERSION=0.1.0
WELCOME_MESSAGE="Hello from NestJS!"

# A secret value. The app only reports whether it is set, it never prints it.
API_SECRET=change-me
